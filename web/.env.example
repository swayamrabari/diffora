# Database (Supabase)
# Runtime: pooled connection (transaction mode, port 6543).
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Migrations: direct connection or session pooler (port 5432).
DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require
# Pool size per serverless instance. Keep small when using a pooler.
DATABASE_POOL_MAX=5

# Auth
# openssl rand -hex 32
JWT_SECRET=change-me-to-at-least-32-random-bytes
# true on HTTPS deployments (Vercel).
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000

# Comparison service
# Local: http://localhost:8080. Hosted: https://api.your-domain.com
COMPARISON_SERVICE_URL=http://localhost:8080
COMPARISON_SHARED_SECRET=change-me-too
# Above the service's 60s diff timeout, below the Vercel function limit.
# On the Hobby plan (60s cap) use 50000; on Pro the default is fine.
COMPARISON_TIMEOUT_MS=90000

# Limits
# Vercel caps request bodies at 4.5 MB, so keep the upload cap below that.
MAX_SPEC_BYTES=2097152
MAX_UPLOAD_REQUEST_BYTES=4194304
MAX_CHANGES_PER_COMPARISON=5000
